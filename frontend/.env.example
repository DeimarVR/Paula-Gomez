# =============================================================================
# [NOMBRE_CLÍNICA] — variables del sitio
# Copia este archivo a `.env` y complétalo:  cp .env.example .env
#
# El sitio y la API viven en el mismo despliegue de Vercel; la base está en
# Railway. Todo lo que NO empieza por NEXT_PUBLIC_ se queda en el servidor y
# nunca llega al navegador.
#
# ¿POR QUÉ .env Y NO .env.local?
# Porque `.env.local` es una convención de Next, y el CLI de Prisma no la
# conoce: solo lee `.env`. Con las variables en `.env.local`, la web arrancaba
# bien pero `prisma migrate deploy` fallaba con "Environment variable not
# found: DATABASE_URL". Next lee los dos archivos, así que `.env` sirve para
# ambos y no hay que mantener el valor duplicado.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# La cadena de Railway. En local usa DATABASE_PUBLIC_URL; en Vercel, la misma.
#
# `connection_limit=1` no es opcional en serverless: cada función abre su
# propio pool y Postgres tiene un tope de conexiones. Sin ese límite, un pico
# de tráfico agota el servidor y la web empieza a fallar de forma intermitente.
DATABASE_URL="postgresql://usuario:clave@host:puerto/base?connection_limit=1&pool_timeout=20"

# --- Seguridad ---------------------------------------------------------------
# Mínimo 16 caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""
JWT_EXPIRES_IN=8h

# Protege la tarea diaria. Vercel lo envía como cabecera Authorization al
# invocarla; sin esta variable la ruta responde 401 y la tarea no corre.
CRON_SECRET=""

# --- Sitio -------------------------------------------------------------------
# Con qué dominio se arman los enlaces que se envían a los pacientes.
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLINIC_TIMEZONE=America/Bogota

# --- Almacenamiento de archivos (bucket S3) --------------------------------
# El bucket es PRIVADO: nada se sirve directo desde él. Las imágenes salen por
# /api/archivos, que decide quién puede verlas. Estas credenciales solo viven
# en el servidor; ninguna empieza por NEXT_PUBLIC_ a propósito.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Datos del centro --------------------------------------------------------
CLINIC_NAME=[NOMBRE_CLÍNICA]
CLINIC_TIMEZONE=America/Bogota
CLINIC_ADDRESS="[DIRECCIÓN]"
# Formato internacional SIN el "+".
CLINIC_WHATSAPP=573000000000

# =============================================================================
# INTEGRACIONES — todas opcionales
# El sistema arranca sin ninguna y cada módulo se degrada con elegancia. Se
# conectan desde /admin/integraciones. Las URIs de redirección apuntan al
# dominio del SITIO, que ahora es también el de la API.
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_REMINDER=
# Ofrecer un hueco liberado: {{1}} el hueco, {{2}} su cita actual, {{3}} el enlace.
WHATSAPP_TEMPLATE_HUECO=
# Disculpa por día cerrado: {{1}} la cita cancelada, {{2}} el enlace para reagendar.
WHATSAPP_TEMPLATE_DIA_CERRADO=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USERNAME=
INSTAGRAM_API_VERSION=v21.0

# --- Seed --------------------------------------------------------------------
# Con SEED_ADMIN_PASSWORD vacío se genera una aleatoria y se imprime UNA vez.
SEED_ADMIN_EMAIL=admin@clinica.com
SEED_ADMIN_PASSWORD=
